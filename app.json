{
  "expo": {
    "name": "BottleFlow",
    "slug": "bottleflow-mobile",
    "scheme": "bottleflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.itc502.bottleflow"
    },
    "android": {
      "package": "com.itc502.bottleflow",
      "adaptiveIcon": {
        "backgroundColor": "#231147",
        "foregroundImage": "./src/assets/images/icon-front.png"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BottleFlow to select a product photo for preview.",
          "cameraPermission": "Allow BottleFlow to capture a product photo for preview.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "purpose": "Western Australia pickup-only bottle shop prototype. No delivery or in-app payment. Original photo ID is compulsory at collection."
    },
    "icon": "./src/assets/images/icon.png",
    "web": {
      "bundler": "metro"
    }
  }
}
