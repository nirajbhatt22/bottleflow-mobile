rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function isManager() { return signedIn() && exists(me()) && get(me()).data.role == 'manager'; }
    function validProduct() {
      return request.resource.data.keys().hasAll(['sku','name','category','priceCents','stock','minStock','active'])
        && request.resource.data.sku is string
        && request.resource.data.name is string
        && request.resource.data.priceCents is int && request.resource.data.priceCents >= 0
        && request.resource.data.stock is int && request.resource.data.stock >= 0
        && request.resource.data.minStock is int && request.resource.data.minStock >= 0
        && request.resource.data.active is bool;
    }
    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isManager());
      allow list: if isManager();
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName','email','role','createdAt'])
        && request.resource.data.role == 'customer'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.createdAt == request.time;
      allow update: if isManager() || (signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && request.resource.data.displayName is string);
      allow delete: if false;
    }
    match /products/{productId} {
      allow get, list: if signedIn() && (isManager() || resource.data.active == true);
      allow create: if isManager() && validProduct() && request.resource.data.sku == productId;
      allow update: if isManager() && validProduct()
        && request.resource.data.sku == resource.data.sku
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
    match /requests/{requestId} {
      allow get, list: if signedIn() && (isManager() || resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'userId','items','status','createdAt','locationId','locationName','locationAddress',
          'window','collector','waPickupOnly','photoIdRequired','ageConfirmed'
        ])
        && request.resource.data.keys().hasAll([
          'userId','items','status','createdAt','locationId','locationName','locationAddress',
          'window','collector','waPickupOnly','photoIdRequired','ageConfirmed'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 20
        && request.resource.data.locationId is string
        && request.resource.data.locationName is string
        && request.resource.data.locationAddress is string
        && request.resource.data.window is string
        && request.resource.data.collector is map
        && request.resource.data.collector.keys().hasOnly(['type','fullName','phone','idType'])
        && request.resource.data.collector.keys().hasAll(['type','fullName','phone','idType'])
        && request.resource.data.collector.type in ['self','nominee']
        && request.resource.data.collector.fullName is string
        && request.resource.data.collector.phone is string
        && request.resource.data.collector.idType is string
        && request.resource.data.waPickupOnly == true
        && request.resource.data.photoIdRequired == true
        && request.resource.data.ageConfirmed == true
        && request.resource.data.createdAt == request.time;
      allow update: if isManager();
      allow delete: if false;
    }
    match /sales/{saleId} { allow read, create, update: if isManager(); allow delete: if false; }
    match /movements/{movementId} { allow read, create: if isManager(); allow update, delete: if false; }
    match /suppliers/{supplierId} { allow read, write: if isManager(); }
    match /settings/{settingId} { allow read: if signedIn(); allow write: if isManager(); }
    match /{document=**} { allow read, write: if false; }
  }
}
